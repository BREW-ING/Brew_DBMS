DATABASE_URL=              # Supabase Postgres connection string (same database as services/ingestion)
AUTH_SECRET=               # signs Auth.js session JWTs; generate with: npx auth secret
AUTH_URL=                  # optional for `npm run dev`; required for `npm run start`/self-hosting, e.g. http://localhost:3000
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
INGESTION_URL=             # base URL of services/ingestion (main.py), e.g. http://localhost:8000
SERVICE_KEY=               # same value as SERVICE_KEY in services/ingestion; also guards /api/internal/*
