# Postgres (Supabase) connection string. Use the Session pooler form
# (Supabase dashboard > Connect > Session pooler):
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The direct form (db.<ref>.supabase.co) only resolves over IPv6, so it fails
# on most home networks and on GitHub Actions runners.
DATABASE_URL=
# GitHub personal access token (public read only, no scopes needed).
# Optional, but unauthenticated requests are limited to 60/hour.
GITHUB_TOKEN=
